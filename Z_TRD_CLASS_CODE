METHOD get_item_details.

  CONSTANTS:
    lc_slash     TYPE char1         VALUE '/',
    lc_comma     TYPE char1         VALUE ',',
    lc_sign      TYPE char1         VALUE 'I',
    lc_option    TYPE char2         VALUE 'EQ',
    lc_per       TYPE char3         VALUE 'Per',
    lc_repid     TYPE progname      VALUE 'ZCOMV_TRD_PROFORMA',
    lc_itm_rem   TYPE zconst_nam    VALUE 'ITEMREMARKS',
    lc_hand_ins  TYPE zconst_nam    VALUE 'HANDLING_INSTR',
    lc_ancl_cst  TYPE zconst_nam    VALUE 'ANCL_COST',
    lc_trnsp_cst TYPE zconst_nam    VALUE 'TRNSP_COST',
    lc_alias     TYPE zconst_nam    VALUE 'ZZALIASTYPE',
    lc_mat_desc  TYPE zconst_nam    VALUE 'MAT_DESC',
    lc_ppu       TYPE zconst_nam    VALUE 'PRICEPERUNIT',
    lc_en        TYPE zconst_name   VALUE 'LANG_CODE_EN',
    lc_ctsty     TYPE /sapsll/ctsty VALUE '01',
    lc_koaid     TYPE koaid         VALUE 'D',
    lc_kposn     TYPE kposn         VALUE '000000'.

  DATA: ls_item       TYPE zcomv_st_trd_inv_form_itm_us,
        ls_batch_info TYPE zcomv_st_trd_batch_details,
        lr_land1      TYPE RANGE OF landx,
        lr_lifnr      TYPE RANGE OF lifnr,
        lv_kbetr      TYPE p        DECIMALS 2,
        lr_alias      TYPE RANGE OF zaliastype_de,
        lr_ppu_kschl  TYPE RANGE OF kschl,
        lt_tline      TYPE STANDARD TABLE OF tline,
        lv_name       TYPE tdobname,
        lv_tdobject   TYPE tdobject,
        lv_tdid       TYPE tdid,
        lv_spras      TYPE spras,
        lv_aubel      TYPE vbeln_va,
        lv_aupos      TYPE posnr_va,
        lv_hsdat      TYPE char11,
        lv_vfdat      TYPE char11,
        lv_subtot     TYPE netwr.

*--Get constants
  SELECT const,
         value
    FROM zconstants_com
    INTO TABLE @DATA(lt_remarks)
    WHERE repid EQ @lc_repid
    ORDER BY const, counter.
  IF sy-subrc = 0.
    "Get the conditions from zconstants table
    DATA(lv_ancl_kschl) = VALUE #( lt_remarks[ const = lc_ancl_cst ]-value OPTIONAL ).
    DATA(lv_trnsp_kschl) = VALUE #( lt_remarks[ const = lc_trnsp_cst ]-value OPTIONAL ).
    lr_alias = VALUE #( FOR ls_const IN lt_remarks WHERE ( const = lc_alias ) ( sign = 'I' option = 'EQ' low = ls_const-value ) ).
    lr_ppu_kschl = VALUE #( FOR ls_const IN lt_remarks WHERE ( const = lc_ppu ) ( sign = 'I' option = 'EQ' low = ls_const-value ) ).
    "Get language
    lv_spras = VALUE #( lt_remarks[ const = lc_en ]-value OPTIONAL ).
  ENDIF.

  DATA(lt_batch) = bil_prt_com_cust-item_detail.
  DELETE lt_batch WHERE vbdpr-charg IS INITIAL.

  IF lt_batch IS NOT INITIAL.
*--Get plant specific data for material
    SELECT matnr,
           werks,
           stawn,
           herkl
      FROM marc
      INTO TABLE @DATA(lt_marc)
      FOR ALL ENTRIES IN @lt_batch
      WHERE matnr EQ @lt_batch-vbdpr-matnr
        AND werks EQ @lt_batch-vbdpr-werks.

    IF sy-subrc = 0 AND lt_marc[] IS NOT INITIAL.
      LOOP AT lt_marc ASSIGNING FIELD-SYMBOL(<lfs_marc>).
        APPEND VALUE #( sign   = lc_sign
                        option = lc_option
                        low    = <lfs_marc>-herkl ) TO lr_land1.
      ENDLOOP.
    ENDIF.

*--Get batch details
    SELECT matnr,
           charg,
           herkl,
           lifnr,
           cuobj_bm,
           licha,
           hsdat,
           vfdat
      FROM mch1
      INTO TABLE @DATA(lt_mch1)
      FOR ALL ENTRIES IN @lt_batch
      WHERE matnr EQ @lt_batch-vbdpr-matnr
        AND charg EQ @lt_batch-vbdpr-charg.
    IF sy-subrc = 0 AND lt_mch1[] IS NOT INITIAL.
      LOOP AT lt_mch1 ASSIGNING FIELD-SYMBOL(<ls_mch1>).

        APPEND VALUE #( sign   = lc_sign
                        option = lc_option
                        low    = <ls_mch1>-herkl ) TO lr_land1.

        APPEND VALUE #( sign   = lc_sign
                        option = lc_option
                        low    = <ls_mch1>-lifnr ) TO lr_lifnr.
      ENDLOOP.
      DELETE lr_lifnr WHERE low IS INITIAL.
      "fetch address details
      IF lr_lifnr IS NOT INITIAL.
        SELECT a~lifnr, a~adrnr, b~name1, b~street, b~house_num1, b~post_code1, b~city1, b~country
          INTO TABLE @DATA(lt_manu_addr)
          FROM lfa1 AS a
          INNER JOIN adrc AS b ON a~adrnr = b~addrnumber
          WHERE a~lifnr IN @lr_lifnr.
        IF sy-subrc = 0.
          LOOP AT lt_manu_addr ASSIGNING FIELD-SYMBOL(<lfs_manu_addr>).
            APPEND VALUE #( sign   = lc_sign
                            option = lc_option
                            low    = <lfs_manu_addr>-country ) TO lr_land1.
          ENDLOOP.
        ENDIF.
      ENDIF.

    ENDIF.

*-- Customs Tarrif No
    SELECT maritc~matnr, maritc~ccngn
      FROM /sapsll/maritc  AS maritc
      INNER JOIN /sapsll/tunos AS tunos ON tunos~stcts = maritc~stcts
      INTO TABLE @DATA(lt_custom_tariff)
      FOR ALL ENTRIES IN @lt_batch
      WHERE tunos~ctsty = @lc_ctsty
      AND maritc~matnr EQ @lt_batch-vbdpr-matnr.
    IF sy-subrc NE 0.
      CLEAR lt_custom_tariff.
    ENDIF.

*-- Storage Condition
    SELECT a~matnr,b~rbtxt
           INTO TABLE @DATA(lt_rbtxt)
           FROM mara AS a
           INNER JOIN t142t AS b ON a~raube = b~raube
           FOR ALL ENTRIES IN @lt_batch
           WHERE a~matnr = @lt_batch-vbdpr-matnr.
    IF sy-subrc = 0.
      SORT lt_rbtxt BY matnr.
    ENDIF.

*-- PCN Code
    SELECT cfg AS matnr, plant, batch AS charg, pcnid
      INTO TABLE @DATA(lt_pcn)
      FROM /ctco/i_cfgbatchdata AS a
      FOR ALL ENTRIES IN @lt_batch
      WHERE a~cfg = @lt_batch-vbdpr-matnr
      AND   a~batch = @lt_batch-vbdpr-charg
      ORDER BY PRIMARY KEY.
    IF sy-subrc <> 0.
      CLEAR lt_pcn.
    ENDIF.
  ENDIF.

  SORT lr_land1 BY low.
  DELETE ADJACENT DUPLICATES FROM lr_land1 COMPARING low.
  DELETE lr_land1 WHERE low IS INITIAL.
*--Get country details
  IF lr_land1[] IS NOT INITIAL.
    SELECT land1,
           landx
      FROM t005t
      INTO TABLE @DATA(lt_t005t)
      WHERE land1 IN @lr_land1
      AND spras EQ @lv_spras
      ORDER BY land1.
    IF sy-subrc NE 0.
      CLEAR lt_t005t.
    ENDIF.
  ENDIF.

*-- Get pricing data
  SELECT knumv,
         kposn,
         kbetr,
         kwert,
         waers,
         kpein,
         kmein,
         kschl
    FROM prcd_elements
    INTO TABLE @DATA(lt_prcd_elements)
    WHERE knumv EQ @bil_prt_com_cust-head_detail-vbdkr-knumv
    ORDER BY knumv, kschl.
  IF sy-subrc NE 0.
    CLEAR lt_prcd_elements.
  ENDIF.

  IF bil_prt_com_cust-item_detail[] IS NOT INITIAL.
*-- Get Material Master - Map synonyms
    SELECT matnr, zzaliastype, zzaliasvalue
      INTO TABLE @DATA(lt_zmapsyn)
      FROM zmapsyn
      FOR ALL ENTRIES IN @bil_prt_com_cust-item_detail
      WHERE matnr = @bil_prt_com_cust-item_detail-vbdpr-matnr
      AND   zzaliastype IN @lr_alias
      ORDER BY PRIMARY KEY.
    IF sy-subrc NE 0.
      CLEAR lt_zmapsyn.
    ENDIF.

    IF lt_prcd_elements IS NOT INITIAL.
*-- Get Ancillary Cost
      IF lv_ancl_kschl IS NOT INITIAL.
        DATA(lt_ancl_cost) = lt_prcd_elements.
        DELETE lt_ancl_cost WHERE kschl NE lv_ancl_kschl+0(4).
        DATA(lv_lines_ancl) = lines( lt_ancl_cost ).
        "If ancillary cost is at header and item both, only consider sum of item ancillary costs
        IF lv_lines_ancl > 1.
          DELETE lt_ancl_cost WHERE kposn IS INITIAL OR kposn EQ lc_kposn.
        ENDIF.
        LOOP AT lt_ancl_cost ASSIGNING FIELD-SYMBOL(<lfs_ancl_cost>).
          us_form-hdr-ancl_cst += <lfs_ancl_cost>-kwert.
        ENDLOOP.
      ENDIF.

*-- Get Transport Cost
      IF lv_trnsp_kschl IS NOT INITIAL.
        DATA(lt_trnsp_cost) = lt_prcd_elements.
        DELETE lt_trnsp_cost WHERE kschl NE lv_trnsp_kschl+0(4).
        "If transport cost is at header and item both, only consider sum of item transport costs
        DATA(lv_lines_trnsp) = lines( lt_trnsp_cost ).
        IF lv_lines_trnsp > 1.
          DELETE lt_trnsp_cost WHERE kposn IS INITIAL OR kposn EQ lc_kposn.
        ENDIF.
        LOOP AT lt_trnsp_cost ASSIGNING FIELD-SYMBOL(<lfs_trnsp_cost>).
          us_form-hdr-trnsp_cst += <lfs_trnsp_cost>-kwert.
        ENDLOOP.
      ENDIF.

    ENDIF.

    CLEAR lv_subtot.
*--Prepare item data
    LOOP AT bil_prt_com_cust-item_detail ASSIGNING FIELD-SYMBOL(<ls_item_detail>).
      IF <ls_item_detail>-vbdpr-aubel = lv_aubel AND <ls_item_detail>-vbdpr-aupos = lv_aupos.
        CONTINUE.
      ELSE.
        lv_aubel = <ls_item_detail>-vbdpr-aubel.
        lv_aupos = <ls_item_detail>-vbdpr-aupos.
      ENDIF.
      CLEAR lv_name.
      "used for read_text
      lv_name = |{ <ls_item_detail>-vbdpr-vbeln }| & |{ <ls_item_detail>-vbdpr-posnr }|.
      ls_item-posnr = <ls_item_detail>-vbdpr-posnr.
      ls_item-matnr = <ls_item_detail>-vbdpr-matnr.

*-- Get Batch Info
      "nested loop is required here as all the batches for one item have to be considered
      LOOP AT lt_batch ASSIGNING FIELD-SYMBOL(<lfs_batch>) WHERE vbdpr-aubel = <ls_item_detail>-vbdpr-aubel
                                                             AND vbdpr-aupos = <ls_item_detail>-vbdpr-aupos.
        ls_batch_info-batch = <lfs_batch>-vbdpr-charg.

        DATA(ls_marc) = VALUE #( lt_marc[ matnr = <lfs_batch>-vbdpr-matnr
                                          werks = <lfs_batch>-vbdpr-werks ] OPTIONAL ).
        IF ls_marc IS NOT INITIAL.
          ls_batch_info-cust_tarrif = VALUE #( lt_custom_tariff[ matnr = <lfs_batch>-vbdpr-matnr ]-ccngn OPTIONAL ).
        ENDIF.
        CLEAR ls_marc.
*-- Get Batch Details
        DATA(ls_mch1) = VALUE #( lt_mch1[ matnr = <lfs_batch>-vbdpr-matnr
                                          charg = <lfs_batch>-vbdpr-charg ] OPTIONAL ).
        IF ls_mch1 IS NOT INITIAL.
*-- Get country of origin
          ls_batch_info-country = VALUE #( lt_t005t[ land1 = ls_mch1-herkl ]-landx OPTIONAL ).
*-- Vendor batch
          ls_batch_info-vendor_batch = ls_mch1-licha.
*-- Manufacturer
          DATA(ls_manu_addr) = VALUE #( lt_manu_addr[ lifnr = ls_mch1-lifnr ] OPTIONAL ).
          IF ls_manu_addr IS NOT INITIAL.
            ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer }{ ls_manu_addr-name1 } { lc_comma }|.
            IF ls_manu_addr-street IS NOT INITIAL.
              ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer } { ls_manu_addr-street }|.
            ENDIF.
            IF ls_manu_addr-house_num1 IS NOT INITIAL.
              ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer } { ls_manu_addr-house_num1 }|.
            ENDIF.
            IF ls_manu_addr-post_code1 IS NOT INITIAL.
              ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer } { ls_manu_addr-post_code1 }|.
            ENDIF.
            IF ls_manu_addr-city1 IS NOT INITIAL.
              ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer } { ls_manu_addr-city1 }|.
            ENDIF.
            DATA(lv_manu_cntry) = VALUE #( lt_t005t[ land1 = ls_manu_addr-country ]-landx OPTIONAL ).
            IF lv_manu_cntry IS NOT INITIAL.
              ls_batch_info-manufacturer = |{ ls_batch_info-manufacturer } { lv_manu_cntry }|.
            ENDIF.
          ENDIF.

*-- Get Manufacturing and Expiry Date
          CALL FUNCTION 'ZCOMV_DATE_CONV_DDMMMYYYY'
            EXPORTING
              i_datum = ls_mch1-hsdat
            IMPORTING
              e_date  = lv_hsdat.

          CALL FUNCTION 'ZCOMV_DATE_CONV_DDMMMYYYY'
            EXPORTING
              i_datum = ls_mch1-vfdat
            IMPORTING
              e_date  = lv_vfdat.

          ls_batch_info-mfdexp = |{ lv_hsdat } { lc_slash } { lv_vfdat }|.
          CLEAR: lv_hsdat, lv_vfdat.

        ENDIF.
        CLEAR: ls_mch1, ls_manu_addr, lv_manu_cntry.

*-- Get PCN ID
        ls_batch_info-pcnid = VALUE #( lt_pcn[ matnr = <lfs_batch>-vbdpr-matnr
                                               charg = <lfs_batch>-vbdpr-charg ]-pcnid OPTIONAL ).

*-- Quantity
        ls_batch_info-quan = <lfs_batch>-vbdpr-fkimg.
        ls_item-fkimg += ls_batch_info-quan.
*-- UOM
        ls_batch_info-uom = <lfs_batch>-vbdpr-vrkme.
        ls_item-vrkme = ls_batch_info-uom.
*-- Net Price
        ls_item-netwr += <lfs_batch>-vbdpr-brtwr.

*-- Price per unit
        IF lr_ppu_kschl IS NOT INITIAL.
          LOOP AT lr_ppu_kschl ASSIGNING FIELD-SYMBOL(<lfs_ppu_kschl>).
            DATA(ls_prcd) = VALUE #( lt_prcd_elements[ kposn = <lfs_batch>-vbdpr-posnr
                                                       kschl = <lfs_ppu_kschl>-low+0(4) ] OPTIONAL ).
            IF ls_prcd IS NOT INITIAL.
              EXIT.
            ENDIF.
          ENDLOOP.
          IF ls_prcd IS NOT INITIAL.
            CLEAR lv_kbetr.
            lv_kbetr = ls_prcd-kbetr.
            ls_item-kbetr += lv_kbetr.
            IF ls_prcd-kmein IS NOT INITIAL AND ls_item-per_unit IS INITIAL.
              CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
                EXPORTING
                  input          = ls_prcd-kmein
                  language       = lv_spras
                IMPORTING
                  output         = ls_prcd-kmein
                EXCEPTIONS
                  unit_not_found = 1
                  OTHERS         = 2.
              IF sy-subrc = 0.
                ls_item-per_unit = |{ lc_per } { ls_prcd-kpein } { ls_prcd-kmein }|.
              ENDIF.
            ENDIF.
          ENDIF.
          CLEAR: ls_prcd.
        ENDIF.

        APPEND ls_batch_info TO ls_item-batch_info.
        CLEAR ls_batch_info.
      ENDLOOP.

      "If there are no batch details for the item, directly take the billing item details
      IF ls_item-batch_info IS INITIAL.
*-- Net price
        ls_item-netwr = <ls_item_detail>-vbdpr-brtwr.
*-- Quantity
        ls_item-fkimg = <ls_item_detail>-vbdpr-fkimg.
*-- UOM
        ls_item-vrkme = <ls_item_detail>-vbdpr-vrkme.
*-- Price per unit
        IF lr_ppu_kschl IS NOT INITIAL.
          CLEAR ls_prcd.
          LOOP AT lr_ppu_kschl ASSIGNING <lfs_ppu_kschl>.
            ls_prcd = VALUE #( lt_prcd_elements[ kposn = <lfs_batch>-vbdpr-posnr
                                                 kschl = <lfs_ppu_kschl>-low+0(4) ] OPTIONAL ).
            IF ls_prcd IS NOT INITIAL.
              EXIT.
            ENDIF.
          ENDLOOP.
          IF ls_prcd IS NOT INITIAL.
            CLEAR lv_kbetr.
            lv_kbetr = ls_prcd-kbetr.
            ls_item-kbetr = lv_kbetr.
            IF ls_prcd-kmein IS NOT INITIAL AND ls_item-per_unit IS INITIAL.
              CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
                EXPORTING
                  input          = ls_prcd-kmein
                  language       = lv_spras
                IMPORTING
                  output         = ls_prcd-kmein
                EXCEPTIONS
                  unit_not_found = 1
                  OTHERS         = 2.
              IF sy-subrc = 0.
                ls_item-per_unit = |{ lc_per } { ls_prcd-kpein } { ls_prcd-kmein }|.
              ENDIF.
            ENDIF.
          ENDIF.
          CLEAR: ls_prcd.
        ENDIF.
      ENDIF.

*-- Material Description
      CLEAR: lv_tdid, lv_tdobject.
      DATA(ls_remarks) = VALUE #( lt_remarks[ const = lc_mat_desc ] OPTIONAL ).
      IF ls_remarks IS NOT INITIAL.
        SPLIT ls_remarks-value AT lc_slash INTO lv_tdid lv_tdobject.
        IF lv_tdid IS NOT INITIAL AND lv_tdobject IS NOT INITIAL.
          CALL FUNCTION 'READ_TEXT'
            EXPORTING
              id                      = lv_tdid
              language                = lv_spras
              name                    = lv_name
              object                  = lv_tdobject
            TABLES
              lines                   = lt_tline
            EXCEPTIONS
              id                      = 1
              language                = 2
              name                    = 3
              not_found               = 4
              object                  = 5
              reference_check         = 6
              wrong_access_to_archive = 7
              OTHERS                  = 8.
          IF sy-subrc = 0.
            ls_item-maktx = VALUE #( lt_tline[ 1 ]-tdline OPTIONAL ).
          ENDIF.
          CLEAR: lv_tdid, lv_tdobject.
        ENDIF.

        "If material description is not not found in text, check zmapsyn
        IF ls_item-maktx IS INITIAL.
          "Alias values are sorted by counter value from zconstants_com
          "Nested loops is required here as all values have to be checked
          LOOP AT lr_alias ASSIGNING FIELD-SYMBOL(<lfs_alias>).
            ls_item-maktx = VALUE #( lt_zmapsyn[ matnr = <ls_item_detail>-vbdpr-matnr
                                            zzaliastype = <lfs_alias>-low ]-zzaliasvalue OPTIONAL ).
            IF ls_item-maktx IS NOT INITIAL.
              EXIT.
            ENDIF.
          ENDLOOP.

          "If material description is not found in zmapsyn, copy arktx
          IF ls_item-maktx IS INITIAL.
            ls_item-maktx = <ls_item_detail>-vbdpr-arktx.
          ENDIF.
        ENDIF.
      ENDIF.
      CLEAR: ls_remarks.

*-- Item Remarks
      CLEAR: lv_tdid, lv_tdobject.
      ls_remarks = VALUE #( lt_remarks[ const = lc_itm_rem ] OPTIONAL ).
      IF ls_remarks IS NOT INITIAL.
        SPLIT ls_remarks-value AT lc_slash INTO lv_tdid lv_tdobject.
        IF lv_tdid IS NOT INITIAL AND lv_tdobject IS NOT INITIAL.
          CALL FUNCTION 'READ_TEXT'
            EXPORTING
              id                      = lv_tdid
              language                = lv_spras
              name                    = lv_name
              object                  = lv_tdobject
            TABLES
              lines                   = lt_tline
            EXCEPTIONS
              id                      = 1
              language                = 2
              name                    = 3
              not_found               = 4
              object                  = 5
              reference_check         = 6
              wrong_access_to_archive = 7
              OTHERS                  = 8.
          IF sy-subrc = 0.
            "Nested loop is needed so all the lines of the Item Remarks are printed
            LOOP AT lt_tline ASSIGNING FIELD-SYMBOL(<lfs_tline>).
              ls_item-item_remarks = |{ ls_item-item_remarks }| & |{ <lfs_tline>-tdline }|.
            ENDLOOP.
          ENDIF.
        ENDIF.
      ENDIF.
      CLEAR ls_remarks.

*-- Storage Condition
      DATA(lv_rbtxt) = VALUE #( lt_rbtxt[ matnr = <ls_item_detail>-vbdpr-matnr ]-rbtxt OPTIONAL ).
      IF lv_rbtxt IS NOT INITIAL.
        ls_item-rbtxt = lv_rbtxt.
      ENDIF.
      CLEAR: lv_rbtxt.


*-- Handling Instruction
      CLEAR: lv_tdid, lv_tdobject.
      ls_remarks = VALUE #( lt_remarks[ const = lc_hand_ins ] OPTIONAL ).
      IF ls_remarks IS NOT INITIAL.
        SPLIT ls_remarks-value AT lc_slash INTO lv_tdid lv_tdobject.
        IF lv_tdid IS NOT INITIAL AND lv_tdobject IS NOT INITIAL.
          CALL FUNCTION 'READ_TEXT'
            EXPORTING
              id                      = lv_tdid
              language                = lv_spras
              name                    = lv_name
              object                  = lv_tdobject
            TABLES
              lines                   = lt_tline
            EXCEPTIONS
              id                      = 1
              language                = 2
              name                    = 3
              not_found               = 4
              object                  = 5
              reference_check         = 6
              wrong_access_to_archive = 7
              OTHERS                  = 8.
          IF sy-subrc = 0.
            "Nested loop is needed so all the lines of the handling instruction are printed
            LOOP AT lt_tline ASSIGNING <lfs_tline>.
              ls_item-handling_instr = |{ ls_item-handling_instr }|  &  |{ <lfs_tline>-tdline }|.
            ENDLOOP.
          ENDIF.
        ENDIF.
      ENDIF.
      CLEAR ls_remarks.

*-- Invoice Subtotal calculation
      lv_subtot += <ls_item_detail>-vbdpr-brtwr.

      APPEND ls_item TO us_form-itm.
      CLEAR ls_item.
    ENDLOOP.
  ENDIF.
*-- Invoice Subtotal
  us_form-hdr-netwr = lv_subtot.
*-- VAT
  us_form-hdr-mwsbk = bil_prt_com_cust-head_detail-vbdkr-mwsbk.

*-- VAT Rate
  SELECT kposn AS kposn, SUM( kbetr ) AS kbetr
    UP TO 1 ROWS
    INTO @DATA(ls_vat)
    FROM prcd_elements
    WHERE knumv = @bil_prt_com_cust-head_detail-vbdkr-knumv
    AND   kstat = @space
    AND   koaid = @lc_koaid
    GROUP BY kposn
    ORDER BY kbetr DESCENDING.
  ENDSELECT.
  IF ls_vat IS NOT INITIAL.
    us_form-hdr-vat_rate = ls_vat-kbetr.
  ENDIF.

*-- Invoice Total
  us_form-hdr-inv_total = us_form-hdr-netwr + us_form-hdr-ancl_cst + us_form-hdr-trnsp_cst + us_form-hdr-mwsbk.

ENDMETHOD.

