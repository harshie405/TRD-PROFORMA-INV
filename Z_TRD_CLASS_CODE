METHOD get_header_details.

  CONSTANTS: lc_re           TYPE parvw          VALUE 'RE',
             lc_we           TYPE parvw          VALUE 'WE',
             lc_slash        TYPE char1          VALUE '/',
             lc_repid        TYPE progname       VALUE 'ZCOMV_TRD_PROFORMA',
             lc_ship_remarks TYPE zconst_name    VALUE 'SHIP_REMARKS',
             lc_end_use      TYPE zconst_name    VALUE 'END_USE',
             lc_invo_rem     TYPE zconst_name    VALUE 'INVOICEREMARKS',
             lc_addnl_rem    TYPE zconst_name    VALUE 'ADDITIONALREMARKS',
             lc_pref_origin  TYPE zconst_name    VALUE 'PREF_ORIGIN',
             lc_sign         TYPE char1          VALUE 'I',
             lc_option       TYPE char2          VALUE 'EQ',
             lc_en           TYPE zconst_name    VALUE 'LANG_CODE_EN',
             lc_exemption    TYPE zconst_name    VALUE 'TAX_EXEMPTION_TEXT',
             lc_73           TYPE char2          VALUE '73',
             lc_to           TYPE char2          VALUE 'TO',
             lc_bo           TYPE char2          VALUE 'BO',
             lc_form_env     TYPE progname       VALUE 'ZFORM_ENVIROMENT',
             lc_const	       TYPE zconst         VALUE 'TEST',
             lc_counter	     TYPE zcounter       VALUE '001',
             lc_truck        TYPE versart        VALUE '01',
             lc_ltl          TYPE versart        VALUE 'LT',
             lc_parcel       TYPE versart        VALUE 'PR',
             lc_kg           TYPE t006-msehi     VALUE 'KG',
             lc_status       TYPE hu_status      VALUE '0060'.

  DATA: lr_land1        TYPE RANGE OF t005t-land1,
        lr_adrnr        TYPE RANGE OF adrc-addrnumber,
        lv_country      TYPE          char2,
        lv_country_val  TYPE          char2,
        lv_gross_weight TYPE          brgew_15,
        lv_net_weight   TYPE          ntgew_15,
        lv_brgew        TYPE          brgew_15,
        lv_ntgew        TYPE          ntgew_15,
        lv_unit_in      TYPE          gewei,
        lv_spras        TYPE          spras.

  DATA: lt_selpar  TYPE          /bobf/t_frw_query_selparam,
        lt_key     TYPE          /bobf/t_frw_key,
        lt_doc_ref TYPE          /scmtms/t_tor_docref_k,
        lt_root    TYPE TABLE OF /scmtms/s_tor_root_k,
        lo_srv_tor TYPE REF TO   /bobf/if_tra_service_manager.

  CLEAR us_form.

  lv_country = ls_vbdkr-landtx.

*--Get operation details
  SELECT repid,
         const,
         value
    FROM zconstants_com
    INTO TABLE @DATA(lt_remarks)
    WHERE repid EQ @lc_repid
    ORDER BY const, counter.
  IF sy-subrc EQ 0.
    "Get language
    lv_spras = VALUE #( lt_remarks[ const = lc_en ]-value OPTIONAL ).

    "Shipping Remarks
    DATA(ls_remarks) = VALUE #( lt_remarks[ const = lc_ship_remarks ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      us_form-hdr-ship_remarks-tdname = ls_vbdkr-vbeln.
      us_form-hdr-ship_remarks-tdspras = lv_spras.
      SPLIT ls_remarks-value AT lc_slash INTO us_form-hdr-ship_remarks-tdid us_form-hdr-ship_remarks-tdobject.
    ENDIF.
    CLEAR ls_remarks.

*-- Mode of transport
    SELECT tvro~vsart
      FROM tvro AS tvro
      INNER JOIN likp AS likp ON likp~route = tvro~route
      INTO @DATA(lv_vsart)
      UP TO 1 ROWS
      WHERE likp~vbeln = @ls_vbdkr-vbeln_vl
      ORDER BY likp~route, tvro~vsart.
    ENDSELECT.
    IF lv_vsart IS NOT INITIAL.
      SELECT SINGLE shippingtype, shippingtypename
        FROM i_shippingtypetext
        WHERE  shippingtype = @lv_vsart
        AND language = @lv_spras
        INTO @DATA(ls_trans_mode).
      IF sy-subrc = 0 AND ls_trans_mode IS NOT INITIAL.
        IF ls_trans_mode-shippingtype = lc_truck OR
           ls_trans_mode-shippingtype = lc_ltl OR
           ls_trans_mode-shippingtype = lc_parcel.
          us_form-hdr-trans_mode = TEXT-001.
        ELSE.
          us_form-hdr-trans_mode =  ls_trans_mode-shippingtypename .
        ENDIF.
      ENDIF.
    ENDIF.
    CLEAR lv_vsart.

**-- Study Code Text
    us_form-hdr-study_code = ls_vbdkr-/ctco/study_id_bld.

*-- Invoice Remarks.
    ls_remarks = VALUE #( lt_remarks[ const = lc_invo_rem ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      us_form-hdr-invo_remarks-name = ls_vbdkr-vbeln.
      us_form-hdr-invo_remarks-language = lv_spras.
      SPLIT ls_remarks-value AT lc_slash INTO us_form-hdr-invo_remarks-id us_form-hdr-invo_remarks-object.
    ENDIF.
    CLEAR ls_remarks.

*-- Additional Remarks
    ls_remarks = VALUE #( lt_remarks[ const = lc_addnl_rem ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      us_form-hdr-addnl_remarks-tdname = ls_vbdkr-vbeln.
      us_form-hdr-addnl_remarks-tdspras = lv_spras.
      SPLIT ls_remarks-value AT lc_slash INTO us_form-hdr-addnl_remarks-tdid
                                              us_form-hdr-addnl_remarks-tdobject.
    ENDIF.
    CLEAR ls_remarks.

**-- Get Tax Exemption text -- Footer
    ls_remarks = VALUE #( lt_remarks[ const = lc_exemption value+0(2) = lv_country ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      SPLIT ls_remarks-value AT lc_slash INTO lv_country_val us_form-hdr-taxex.
    ENDIF.
    CLEAR: ls_remarks,lv_country_val.

**-- Get End Use Policy -- Footer
    ls_remarks = VALUE #( lt_remarks[ const = lc_end_use ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      us_form-hdr-f_remarks-tdname = ls_vbdkr-vbeln.
      us_form-hdr-f_remarks-tdspras = lv_spras.
      SPLIT ls_remarks-value AT lc_slash INTO us_form-hdr-f_remarks-tdid us_form-hdr-f_remarks-tdobject.
    ENDIF.
    CLEAR ls_remarks.

**-- Get Preferential Origin Text -- Footer
    ls_remarks = VALUE #( lt_remarks[ const = lc_pref_origin ] OPTIONAL ).
    IF ls_remarks IS NOT INITIAL.
      us_form-hdr-pref_origin-tdname = ls_vbdkr-vbeln.
      us_form-hdr-pref_origin-tdspras = lv_spras.
      SPLIT ls_remarks-value AT lc_slash INTO us_form-hdr-pref_origin-tdid us_form-hdr-pref_origin-tdobject.
    ENDIF.
    CLEAR ls_remarks.
  ENDIF.

*--Get incoterm
  IF ls_vbdkr-inco2 IS NOT INITIAL.
    us_form-hdr-incot = |{ ls_vbdkr-inco1 } { lc_slash } { ls_vbdkr-inco2 }|.
  ELSE.
    us_form-hdr-incot = |{ ls_vbdkr-inco1 }|.
  ENDIF.

*-- Get terms of payment
  IF ls_vbdkr-zterm IS NOT INITIAL.
    SELECT SINGLE vtext
      INTO @DATA(lv_vtext)
      FROM tvzbt
      WHERE spras = @lv_spras
      AND   zterm = @ls_vbdkr-zterm.
    IF sy-subrc = 0.
      us_form-hdr-dzterm_bez = lv_vtext.
      CLEAR lv_vtext.
    ENDIF.
  ENDIF.

*--Get plant details
  SELECT SINGLE adrnr,
                land1,
                waers,
                ort01
    FROM t001
    INTO @DATA(ls_t001)
    WHERE bukrs = @ls_vbdkr-bukrs.

  IF sy-subrc = 0 AND ls_t001 IS NOT INITIAL.

    APPEND VALUE #( sign   = lc_sign
                    option = lc_option
                    low    = ls_t001-adrnr ) TO lr_adrnr.

    APPEND VALUE #( sign   = lc_sign
                    option = lc_option
                    low    = ls_t001-land1 ) TO lr_land1.
  ENDIF.

*--Get partner details
  SELECT a~vbeln,
         a~parvw,
         a~adrnr,
         a~kunnr,
         b~stceg
    FROM vbpa AS a
    LEFT OUTER JOIN kna1 AS b ON a~kunnr = b~kunnr
    INTO TABLE @DATA(lt_vbpa)
    WHERE vbeln = @ls_vbdkr-vbeln
    AND parvw IN ( @lc_re, @lc_we )
    ORDER BY a~vbeln.
  IF sy-subrc EQ 0 AND lt_vbpa IS NOT INITIAL.
*--Get VAT registration number
    DATA(lv_vat_reg) = VALUE #( lt_vbpa[ 1 ]-stceg OPTIONAL ).
    us_form-hdr-stceg_ag = lv_vat_reg.

    LOOP AT lt_vbpa ASSIGNING FIELD-SYMBOL(<fs_vbpa>).
      APPEND VALUE #( sign   = lc_sign
                      option = lc_option
                      low    = <fs_vbpa>-adrnr ) TO lr_adrnr.
    ENDLOOP.
  ENDIF.

* Fetching Bill-to Account
  us_form-hdr-bill_to_acc = ls_vbdkr-kunre. "bill-to-acc
* Fetching Ship-to Account
  us_form-hdr-ship_to_acc = ls_vbdkr-kunwe. "Ship-to-party

*--Get partner address details
  IF lr_adrnr[] IS NOT INITIAL.
    SELECT addrnumber,
           tel_number,
           fax_number,
           country,
           region,
           name1,
           name2,
           house_num1,
           street,
           str_suppl1,
           post_code1,
           city1
      FROM adrc
      INTO TABLE @DATA(lt_adrc)
      WHERE addrnumber IN @lr_adrnr.

    IF sy-subrc = 0 AND lt_adrc[] IS NOT INITIAL.
      DATA(ls_adrc) = VALUE #( lt_adrc[ addrnumber = ls_t001-adrnr ] OPTIONAL ).
      IF ls_adrc IS NOT INITIAL.
        us_form-hdr-cc_name1 = |{ ls_adrc-name1 }|.
        IF ls_adrc-street IS NOT INITIAL.
          us_form-hdr-cc_adrnr = |{ us_form-hdr-cc_adrnr }{ ls_adrc-street }{ cl_abap_char_utilities=>newline }|.
        ENDIF.
        IF ls_adrc-str_suppl1 IS NOT INITIAL.
          us_form-hdr-cc_adrnr = |{ us_form-hdr-cc_adrnr }{ ls_adrc-str_suppl1 }{ cl_abap_char_utilities=>newline }|.
        ENDIF.
        IF ls_adrc-post_code1 IS NOT INITIAL.
          us_form-hdr-cc_adrnr = |{ us_form-hdr-cc_adrnr }{ ls_adrc-post_code1 }{ cl_abap_char_utilities=>newline }|.
        ENDIF.
        IF ls_adrc-city1 IS NOT INITIAL.
          us_form-hdr-cc_adrnr = |{ us_form-hdr-cc_adrnr }{ ls_adrc-city1 }{ cl_abap_char_utilities=>newline }|.
        ENDIF.
        IF ls_t001-ort01 IS NOT INITIAL.
          us_form-hdr-cc_adrnr = |{ us_form-hdr-cc_adrnr }{ ls_t001-ort01 }|.
        ENDIF.

        APPEND VALUE #( sign   = lc_sign
                        option = lc_option
                        low    = ls_adrc-country ) TO lr_land1.

        CLEAR ls_adrc.
      ENDIF.

      "Bill-to address
      DATA(ls_vbpa_re) = VALUE #( lt_vbpa[ vbeln = ls_vbdkr-vbeln parvw =  lc_re ] OPTIONAL ).
      IF ls_vbpa_re IS NOT INITIAL.
        CLEAR: ls_adrc.
        ls_adrc = VALUE #( lt_adrc[ addrnumber =  ls_vbpa_re-adrnr ] OPTIONAL ) .
        IF ls_adrc IS NOT INITIAL.
          us_form-hdr-sp_name1 = |{ ls_adrc-name1 }{ ls_adrc-name2 }|.
          IF ls_adrc-street IS NOT INITIAL.
            us_form-hdr-sp_adrnr = |{ us_form-hdr-sp_adrnr }{ ls_adrc-street }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-house_num1 IS NOT INITIAL.
            us_form-hdr-sp_adrnr = |{ us_form-hdr-sp_adrnr }{ ls_adrc-house_num1 }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-post_code1 IS NOT INITIAL.
            us_form-hdr-sp_adrnr = |{ us_form-hdr-sp_adrnr }{ ls_adrc-post_code1 }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-street IS NOT INITIAL.
            us_form-hdr-sp_adrnr = |{ us_form-hdr-sp_adrnr }{ ls_adrc-city1 }|.
          ENDIF.

          us_form-hdr-tel_number = ls_adrc-tel_number.
          us_form-hdr-fax_number = ls_adrc-fax_number.
          DATA(ls_country_re) = ls_adrc-country.

          APPEND VALUE #( sign   = lc_sign
                          option = lc_option
                          low    = ls_adrc-country ) TO lr_land1.
        ENDIF.
      ENDIF.

      "Ship-to/Consignee Address
      DATA(ls_vbpa_we) = VALUE #( lt_vbpa[ vbeln = ls_vbdkr-vbeln parvw =  lc_we ] OPTIONAL ).
      IF ls_vbpa_we IS NOT INITIAL.
        CLEAR:ls_adrc.
        ls_adrc = VALUE #( lt_adrc[ addrnumber =  ls_vbpa_we-adrnr ] OPTIONAL ) .
        IF ls_adrc IS NOT INITIAL.

          us_form-hdr-con_name1 = |{ ls_adrc-name1 }{ ls_adrc-name2 }|.
          IF ls_adrc-street IS NOT INITIAL.
            us_form-hdr-consgn_adrnr = |{ us_form-hdr-consgn_adrnr }{ ls_adrc-street }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-house_num1 IS NOT INITIAL.
            us_form-hdr-consgn_adrnr = |{ us_form-hdr-consgn_adrnr }{ ls_adrc-house_num1 }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-post_code1 IS NOT INITIAL.
            us_form-hdr-consgn_adrnr = |{ us_form-hdr-consgn_adrnr }{ ls_adrc-post_code1 }{ cl_abap_char_utilities=>newline }|.
          ENDIF.
          IF ls_adrc-city1 IS NOT INITIAL.
            us_form-hdr-consgn_adrnr = |{ us_form-hdr-consgn_adrnr }{ ls_adrc-city1 }|.
          ENDIF.

          DATA(ls_country_we) = ls_adrc-country.

          APPEND VALUE #( sign   = lc_sign
                          option = lc_option
                          low    = ls_adrc-country ) TO lr_land1.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

*-- Get country details LANDX
  IF lr_land1 IS NOT INITIAL AND lv_spras IS NOT INITIAL.
    SELECT land1,
           landx
      FROM t005t
      INTO TABLE @DATA(lt_t005t)
      WHERE land1 IN @lr_land1
        AND spras EQ @ls_remarks-value.

    IF sy-subrc = 0 AND lt_t005t[] IS NOT INITIAL.
*-- Bill to LANDX
      DATA(ls_t005t) = VALUE #( lt_t005t[ land1 = ls_country_re ] OPTIONAL ).
      IF ls_t005t IS NOT INITIAL.
        us_form-hdr-sp_landx = |{ ls_t005t-landx }|.
        CLEAR ls_t005t.
      ENDIF.
**-- Consignee Address LANDX
      ls_t005t = VALUE #( lt_t005t[ land1 = ls_country_we ] OPTIONAL ).
      IF ls_t005t IS NOT INITIAL.
        us_form-hdr-con_landx = |{ ls_t005t-landx }|.
        CLEAR ls_t005t.
      ENDIF.

      ls_t005t = VALUE #( lt_t005t[ land1 = ls_t001-land1 ] OPTIONAL ).
      IF ls_t005t IS NOT INITIAL.
        us_form-hdr-cc_landx = ls_t005t-landx.
        CLEAR ls_t005t.
      ENDIF.
    ENDIF.
    CLEAR ls_remarks.
  ENDIF.

*-- Get Transport Order number
  TRY.

      lo_srv_tor = /bobf/cl_tra_serv_mgr_factory=>get_service_manager( /scmtms/if_tor_c=>sc_bo_key ).

      APPEND VALUE #( attribute_name = /scmtms/if_tor_c=>sc_query_attribute-docreference-docreference_elements-btd_id
                      option = lc_option
                      sign   = lc_sign
                      low    = ls_vbdkr-vbeln_vl ) TO lt_selpar.

      APPEND VALUE #( attribute_name = /scmtms/if_tor_c=>sc_query_attribute-docreference-docreference_elements-btd_tco
                      option = lc_option
                      sign   = lc_sign
                      low    = lc_73 ) TO lt_selpar.

      CALL METHOD lo_srv_tor->query
        EXPORTING
          iv_query_key            = /scmtms/if_tor_c=>sc_query-docreference-docreference_elements
          it_selection_parameters = lt_selpar
        IMPORTING
          et_key                  = lt_key.

      IF lt_key IS NOT INITIAL.
        CALL METHOD lo_srv_tor->retrieve
          EXPORTING
            iv_node_key = /scmtms/if_tor_c=>sc_node-docreference
            it_key      = lt_key
          IMPORTING
            et_data     = lt_doc_ref.

        CLEAR: lt_key.
        IF lt_doc_ref IS NOT INITIAL.
          LOOP AT lt_doc_ref ASSIGNING FIELD-SYMBOL(<fs_doc_ref>).
            APPEND VALUE #( key = <fs_doc_ref>-root_key ) TO lt_key.
          ENDLOOP.

          CALL METHOD lo_srv_tor->retrieve
            EXPORTING
              iv_node_key = /scmtms/if_tor_c=>sc_node-root
              it_key      = lt_key
            IMPORTING
              et_data     = lt_root.
        ENDIF.
      ENDIF.
    CATCH /bobf/cx_frw_contrct_violation.
      CLEAR lt_selpar.
  ENDTRY.

  IF us_form-hdr-trans_mode EQ TEXT-001.
    us_form-hdr-tor_id = VALUE #( lt_root[ tor_cat = lc_to ]-tor_id OPTIONAL ).
  ELSE.
    us_form-hdr-tor_id = VALUE #( lt_root[ tor_cat = lc_bo ]-tor_id OPTIONAL ).
  ENDIF.

*Get Handling unit for Delivery - Total Gross and Net weight
  IF ls_vbdkr-vbeln_vl IS NOT INITIAL.
    SELECT vpobjkey, brgew, ntgew, gewei
    INTO TABLE @DATA(lt_total_weights)
    FROM vekp
    WHERE vpobjkey = @ls_vbdkr-vbeln_vl
    AND status <> @lc_status.
  ENDIF.
**Populate delivery Handling unit total gross and net weight.
  IF lt_total_weights IS NOT INITIAL.
    LOOP AT lt_total_weights ASSIGNING FIELD-SYMBOL(<lf_totalwt>).
      lv_brgew += <lf_totalwt>-brgew.
      lv_ntgew += <lf_totalwt>-ntgew.
      lv_unit_in = us_form-hdr-gewei_max = <lf_totalwt>-gewei.
    ENDLOOP.
  ELSE.
    lv_brgew = ls_vbdkr-brgew.
    lv_ntgew = ls_vbdkr-ntgew.
    lv_unit_in = us_form-hdr-gewei_max = ls_vbdkr-gewei.
  ENDIF.

  IF lv_unit_in NE lc_kg.
**Gross Weight in KG
    CALL METHOD zcomv_cl_trd_invoice_form_us=>convert_units
      EXPORTING
        iv_input    = lv_brgew
        iv_unit_in  = lv_unit_in
        iv_unit_out = lc_kg
      IMPORTING
        ev_output   = lv_gross_weight.
    IF lv_gross_weight IS NOT INITIAL.
      us_form-hdr-gewei_max = lc_kg.
      WRITE: lv_gross_weight TO us_form-hdr-brgew UNIT us_form-hdr-gewei_max.
      CONDENSE us_form-hdr-brgew NO-GAPS.
      us_form-hdr-brgew = |{ us_form-hdr-brgew } { us_form-hdr-gewei_max }|.
    ENDIF.
**Net Weight in KG
    CALL METHOD zcomv_cl_trd_invoice_form_us=>convert_units
      EXPORTING
        iv_input    = lv_ntgew
        iv_unit_in  = lv_unit_in
        iv_unit_out = lc_kg
      IMPORTING
        ev_output   = lv_net_weight.
    IF lv_net_weight IS NOT INITIAL.
      us_form-hdr-gewei_max = lc_kg.
      WRITE: lv_net_weight TO us_form-hdr-ntgew UNIT us_form-hdr-gewei_max.
      CONDENSE us_form-hdr-ntgew NO-GAPS.
      us_form-hdr-ntgew = |{ us_form-hdr-ntgew } { us_form-hdr-gewei_max }|.
    ENDIF.
  ELSE.
    WRITE: lv_brgew TO us_form-hdr-brgew UNIT us_form-hdr-gewei_max.
    CONDENSE us_form-hdr-brgew NO-GAPS.
    us_form-hdr-brgew = |{ us_form-hdr-brgew } { us_form-hdr-gewei_max }|.
    WRITE: lv_ntgew TO us_form-hdr-ntgew UNIT us_form-hdr-gewei_max.
    CONDENSE us_form-hdr-ntgew NO-GAPS.
    us_form-hdr-ntgew = |{ us_form-hdr-ntgew } { us_form-hdr-gewei_max }|.
  ENDIF.

*--Print TEST in form for Dev and Quality system
  SELECT SINGLE value INTO @DATA(lv_value)
    FROM zconstants
    WHERE repid   = @lc_form_env
      AND const   = @lc_const
      AND counter = @lc_counter.
  IF sy-subrc = 0 AND lv_value IS NOT INITIAL.
    us_form-hdr-test  = TEXT-010.
  ELSE.
    CLEAR : us_form-hdr-test.
  ENDIF.

ENDMETHOD.

