  METHOD convert_units.

    CLEAR ev_output.

    CALL FUNCTION 'UNIT_CONVERSION_SIMPLE'
      EXPORTING
        input                = iv_input
        unit_in              = iv_unit_in
        unit_out             = iv_unit_out
      IMPORTING
        output               = ev_output
      EXCEPTIONS
        conversion_not_found = 1
        division_by_zero     = 2
        input_invalid        = 3
        output_invalid       = 4
        overflow             = 5
        type_invalid         = 6
        units_missing        = 7
        unit_in_not_found    = 8
        unit_out_not_found   = 9
        OTHERS               = 10.
    IF sy-subrc NE 0.
      CLEAR ev_output.
    ENDIF.
  ENDMETHOD.
